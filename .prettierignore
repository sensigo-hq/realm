# Brand kit: logo, favicon and badge files plus the kit page are delivered as they are.
# Formatting them would change files that are meant to match the kit exactly.
brand-kit/

# The website's build outputs, written by `npm run build` in website/ and ignored by git
# (website/.gitignore). Prettier does not read that file, so without these lines a check or a
# commit hook after a local website build would format or report generated files.
website/.astro/
website/src/content/
website/public/live/
website/src/live/manifest.json

# CP-7: each published release's corpus, as scripts/corpus/record.mjs wrote it from the published
# package. The cells compare it parsed, so its formatting is never the check; formatting it would
# change recorded files. The cells and the rules file beside the folders stay checked.
packages/cli/src/corpus/[0-9]*/
