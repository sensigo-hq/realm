---
// The public comparison page. Everything on it is derived from the main comparison document,
// src/data/comparison.json, through src/lib/comparison.mjs, which stops the build if the document
// is incomplete. Edit the facts there, never here. The main document also holds what this page
// leaves out on purpose: the prices (fact `paid-offer`, public: false) and the platform rows
// used for an internal score.
import { nav } from '../data/nav.js';
import '../styles/site.css';
import ThemeToggle from '../components/ThemeToggle.astro';
import { THEME_INIT } from '../lib/theme-init.mjs';
import { ICON_LINKS, THEME_COLOR } from '../lib/favicon.mjs';
import Logo from '../components/Logo.astro';
import PageMeta from '../components/PageMeta.astro';
import { COMPARE_DESCRIPTION, SOURCE_URL } from '../lib/site-meta.mjs';
import { tools, rows, publicFacts, strengths, rowsByVerdict } from '../lib/comparison.mjs';

const PILL = { Yes: 'yes', Partial: 'part', No: 'no', 'N/A': 'na' };
const VERDICT = {
  lead: ['v-lead', 'Only Realm'],
  level: ['v-level', 'Level with the field'],
  behind: ['v-behind', 'Realm is behind'],
  open: ['v-open', 'Nobody has it'],
};
const WORDS = ['no', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine', 'ten', 'eleven', 'twelve'];
const others = tools.length - 1;
const othersWord = WORDS[others] ?? String(others);
const totalWord = WORDS[tools.length] ?? String(tools.length);

// Column groups for the table header, in the document's tool order.
const groups = [];
for (const t of tools) {
  if (groups.length && groups.at(-1).name === t.group) groups.at(-1).span += 1;
  else groups.push({ name: t.group, span: 1 });
}

// The adoption line: Realm's stars against the range of the others, from the stars fact.
const stars = publicFacts.find((f) => f.id === 'stars');
const n = (s) => Number(String(s).replace(/[^0-9]/g, ''));
const otherStars = stars ? tools.filter((t) => t.key !== 'realm').map((t) => n(stars.cells[t.key])) : [];
const fmt = (x) => x.toLocaleString('en-US');
const adoption = stars
  ? `Adoption: ${stars.cells.realm} GitHub star${n(stars.cells.realm) === 1 ? '' : 's'}, against ${fmt(Math.min(...otherStars))} to ${fmt(Math.max(...otherStars))} for the others`
  : null;

const checkedDates = [...new Set(tools.map((t) => t.checked))].sort();
const lastChecked = checkedDates.at(-1);
const issueUrl = `${SOURCE_URL}/issues/new?title=${encodeURIComponent('Comparison: ')}&body=${encodeURIComponent(
  'Which tool and which question:\n\nWhat the page says:\n\nWhat is true (with a link to the tool\'s own code or docs, and its version):\n',
)}`;
const dataUrl = `${SOURCE_URL}/blob/main/website/src/data/comparison.json`;
const groupsOf = [
  ['lead', 'Only Realm', rowsByVerdict('lead')],
  ['level', 'Level with the field', rowsByVerdict('level')],
  ['behind', 'Realm is behind', rowsByVerdict('behind')],
  ['open', 'Nobody has it', rowsByVerdict('open')],
].filter(([, , list]) => list.length > 0);
---

<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<script is:inline set:html={THEME_INIT}></script>
{ICON_LINKS.map((a) => <link {...a} />)}
<meta name="theme-color" content={THEME_COLOR} />
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
<PageMeta title="How Realm compares with LangGraph, CrewAI, Temporal, n8n and others" description={COMPARE_DESCRIPTION} path="/compare/" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap" />
<style is:global>
/* The comparison: a summary in four groups, one wide table that scrolls inside its own box,
   then every answer with its source, one card per tool, and how it was checked. */
:root { --danger: var(--c-danger); --danger-soft: color-mix(in srgb, var(--c-danger) 14%, var(--c-panel)); }
.summary { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr)); gap: 14px; }
.sbox { background: var(--panel); border: 1px solid var(--line-soft); border-radius: 10px; padding: 16px 18px; }
.sbox h3 { font-size: 15px; font-weight: 600; display: flex; align-items: center; gap: 8px; }
.sbox ul { margin: 10px 0 0; padding-left: 18px; display: grid; gap: 6px; font-size: 15px; }
.sbox p { margin: 8px 0 0; font-size: 14px; color: var(--muted); }
.dot { width: 10px; height: 10px; border-radius: 50%; display: inline-block; flex: none; }
.dot.lead { background: var(--accent); } .dot.level { background: var(--muted); }
.dot.behind { background: var(--warn); } .dot.open { background: var(--danger); }
.legend { display: flex; flex-wrap: wrap; gap: 8px 16px; margin-top: 12px; font-size: 14px; color: var(--muted); align-items: center; }
.scroll { overflow-x: auto; border: 1px solid var(--line-soft); border-radius: 10px; background: var(--panel); margin-top: 14px; }
table.matrix { border-collapse: separate; border-spacing: 0; width: max-content; min-width: 100%; font-size: 13px; }
.matrix th, .matrix td { padding: 9px 10px; border-bottom: 1px solid var(--line-soft); text-align: center; vertical-align: middle; }
.matrix thead th { background: var(--panel2); color: var(--ink); font-weight: 600; }
.matrix th.grp { font: 500 11px/1.3 'IBM Plex Mono', ui-monospace, monospace; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); border-bottom: 1px solid var(--line); }
.tname { display: block; font-size: 13px; }
.tver { display: block; font: 400 11px/1.35 'IBM Plex Mono', ui-monospace, monospace; color: var(--muted); margin-top: 2px; }
.rowhead { position: sticky; left: 0; z-index: 1; text-align: left !important; background: var(--panel); min-width: 220px; max-width: 250px; font-weight: 500; }
thead .rowhead { background: var(--panel2); z-index: 2; }
.rowhead a { color: var(--ink); text-decoration: none; display: block; }
.rowhead a:hover { text-decoration: underline; }
.rowhead .vchip { margin-top: 6px; }
.matrix .realm { background: var(--accent-soft); }
.matrix thead th.realm { box-shadow: inset 0 3px 0 var(--accent); }
.matrix tr.sep th, .matrix tr.sep td { background: var(--panel2); font: 500 11px/1.3 'IBM Plex Mono', ui-monospace, monospace; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); padding-block: 6px; }
.matrix tr.fact td { font-size: 12.5px; color: var(--body); max-width: 170px; min-width: 120px; text-align: left; line-height: 1.4; font-variant-numeric: tabular-nums; }
.pill { display: inline-block; font: 500 12px/1 'IBM Plex Sans', system-ui, sans-serif; padding: 5px 9px; border-radius: 999px; white-space: nowrap; border: 1px solid transparent; }
.pill.yes { background: var(--accent-soft); color: var(--accent); border-color: color-mix(in srgb, var(--accent) 45%, transparent); }
.pill.part { background: var(--warn-soft); color: var(--warn); border-color: color-mix(in srgb, var(--warn) 45%, transparent); }
.pill.no { background: var(--danger-soft); color: var(--danger); border-color: color-mix(in srgb, var(--danger) 40%, transparent); }
.pill.na { background: var(--panel2); color: var(--muted); }
.vchip { display: inline-block; font: 500 11px/1.2 'IBM Plex Mono', ui-monospace, monospace; letter-spacing: .04em; padding: 3px 7px; border-radius: 4px; }
.v-lead { background: var(--accent-soft); color: var(--accent); }
.v-level { background: var(--panel2); color: var(--muted); }
.v-behind { background: var(--warn-soft); color: var(--warn); }
.v-open { background: var(--danger-soft); color: var(--danger); }
.qrows { display: grid; gap: 28px; margin-top: 8px; }
section.q { border-top: 1px solid var(--line); padding-top: 22px; scroll-margin-top: 16px; }
.qtop { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 14px; }
.qtop h3 { font-size: 19px; font-weight: 600; }
.ask { margin: 6px 0 0; color: var(--muted); font-size: 15px; }
.verdict { margin: 10px 0 0; max-width: 78ch; color: var(--ink); }
ul.cells { list-style: none; margin: 16px 0 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(250px, 100%), 1fr)); gap: 12px; }
.cell { background: var(--panel); border: 1px solid var(--line-soft); border-radius: 8px; padding: 12px 14px; min-width: 0; }
.cell.realm { border-color: var(--accent); background: var(--accent-soft); }
.chead { display: flex; justify-content: space-between; align-items: center; gap: 8px; }
.cname { color: var(--ink); font-weight: 600; font-size: 14px; }
.cell p { margin: 8px 0 0; font-size: 14px; line-height: 1.5; }
.cell p.src { font: 400 11.5px/1.45 'IBM Plex Mono', ui-monospace, monospace; color: var(--muted); overflow-wrap: anywhere; }
.lab { color: var(--ink); background: var(--panel2); border-radius: 3px; padding: 1px 4px; margin-right: 4px; white-space: nowrap; }
.cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(280px, 100%), 1fr)); gap: 14px; margin-top: 14px; }
.card { background: var(--panel); border: 1px solid var(--line-soft); border-radius: 10px; padding: 16px 18px; min-width: 0; }
.card.realm { border-color: var(--accent); }
.card h3 { font-size: 17px; font-weight: 600; }
.cgroup { font: 400 11.5px/1.4 'IBM Plex Mono', ui-monospace, monospace; color: var(--muted); margin: 4px 0 0; }
.card h4 { font: 500 11px/1.3 'IBM Plex Mono', ui-monospace, monospace; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); margin: 14px 0 0; }
.card p { margin: 6px 0 0; font-size: 14px; }
@media (max-width: 520px) { .rowhead { min-width: 160px; max-width: 180px; } }
</style>
</head>
<body>
<div class="wrap">

  <nav class="site">
    <a class="brand" href="/" aria-label="Realm"><Logo /></a>
    <div class="links">{nav.map((l) => <a href={l.href} aria-current={l.href === '/compare' ? 'page' : undefined}>{l.label}</a>)}</div>
    <ThemeToggle />
  </nav>

  <header class="hero">
    <div class="eyebrow">Comparison</div>
    <h1>How Realm compares</h1>
    <p class="lede">Realm against {othersWord} tools people consider for the same job: getting an AI agent to do multi-step work reliably. Every answer below cites the tool's own code or docs, and each column names the release that was checked and when. Where Realm is behind, the page says so.</p>
  </header>

  <div class="summary">
    {groupsOf.map(([kind, label, list]) => (
      <div class="sbox">
        <h3><span class={`dot ${kind}`}></span>{label}</h3>
        <ul>
          {list.map((r) => <li><a href={`#${r.id}`}>{r.title}</a></li>)}
          {kind === 'behind' && adoption && <li>{adoption}</li>}
        </ul>
      </div>
    ))}
  </div>

  <section aria-labelledby="table">
    <div class="eyebrow">The table</div>
    <h2 id="table">{totalWord.charAt(0).toUpperCase() + totalWord.slice(1)} tools, {rows.length} questions</h2>
    <p>Each row is a question. Its name links to every tool's answer, with the source. The highlighted column is Realm.</p>
    <div class="legend"><span class="pill yes">Yes</span><span class="pill part">Partial</span><span class="pill no">No</span><span>Partial always means something is missing; the answers below say what.</span></div>
    <div class="scroll" role="region" aria-label="Comparison table" tabindex="0">
      <table class="matrix">
        <thead>
          <tr>
            <th class="rowhead" rowspan="2" scope="col">Question</th>
            {groups.map((g) => <th class="grp" colspan={g.span} scope="colgroup">{g.name}</th>)}
          </tr>
          <tr>
            {tools.map((t) => (
              <th scope="col" class={t.key === 'realm' ? 'realm' : undefined}>
                <span class="tname">{t.name}</span><span class="tver">{t.version}</span><span class="tver">checked {t.checked}</span>
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          {rows.map((r) => (
            <tr>
              <th scope="row" class="rowhead"><a href={`#${r.id}`}>{r.title}</a><span class={`vchip ${VERDICT[r.verdict.kind][0]}`}>{VERDICT[r.verdict.kind][1]}</span></th>
              {tools.map((t) => (
                <td class={t.key === 'realm' ? 'realm' : undefined} title={`${t.name}: ${r.cells[t.key].note}`}><span class={`pill ${PILL[r.cells[t.key].value]}`}>{r.cells[t.key].value}</span></td>
              ))}
            </tr>
          ))}
          <tr class="sep"><th scope="row" class="rowhead">Facts</th>{tools.map((t) => <td class={t.key === 'realm' ? 'realm' : undefined}></td>)}</tr>
          {publicFacts.map((f) => (
            <tr class="fact">
              <th scope="row" class="rowhead">{f.title}</th>
              {tools.map((t) => <td class={t.key === 'realm' ? 'realm' : undefined}>{f.cells[t.key]}</td>)}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section aria-labelledby="answers">
    <div class="eyebrow">Question by question</div>
    <h2 id="answers">Every answer, with its source</h2>
    <p>Each answer says how it was checked: <span class="lab">CODE</span> read in the tool's source, <span class="lab">DOCS</span> stated in its own docs, <span class="lab">EXECUTED</span> run, <span class="lab">INFERRED</span> reasoned from what was read.</p>
    <div class="qrows">
      {rows.map((r) => (
        <section class="q" id={r.id}>
          <div class="qtop"><h3>{r.title}</h3><span class={`vchip ${VERDICT[r.verdict.kind][0]}`}>{VERDICT[r.verdict.kind][1]}</span></div>
          <p class="ask">{r.ask}</p>
          <p class="verdict">{r.verdict.text}</p>
          <ul class="cells">
            {tools.map((t) => (
              <li class={t.key === 'realm' ? 'cell realm' : 'cell'}>
                <div class="chead"><span class="cname">{t.name}</span><span class={`pill ${PILL[r.cells[t.key].value]}`}>{r.cells[t.key].value}</span></div>
                <p>{r.cells[t.key].note}</p>
                <p class="src"><span class="lab">{r.cells[t.key].label}</span> {r.cells[t.key].source}</p>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </section>

  <section aria-labelledby="tools">
    <div class="eyebrow">Tool by tool</div>
    <h2 id="tools">What each one does better, and where it falls short</h2>
    <p>Where each tool is stronger than Realm, and where it falls short for making an agent follow steps and show what it did.</p>
    <div class="cards">
      {tools.map((t) => (
        <article class={t.key === 'realm' ? 'card realm' : 'card'}>
          <h3>{t.name}</h3>
          <p class="cgroup">{t.group} · {t.version} · checked {t.checked}</p>
          <h4>Stronger at</h4><p>{strengths[t.key].stronger}</p>
          <h4>Weaker at</h4><p>{strengths[t.key].weaker}</p>
        </article>
      ))}
    </div>
  </section>

  <section aria-labelledby="how">
    <div class="eyebrow">How this was checked</div>
    <h2 id="how">Sources, dates and corrections</h2>
    <ul>
      <li>Each tool was read at the release named in its column: its own source code, docs and release notes. Blog posts, comparison articles and AI summaries were not used.</li>
      <li>Realm's own column was checked by a separate pass told to find its weaknesses, and its key answers were run on the published release.</li>
      <li>"Only Realm", "Level with the field", "Realm is behind" and "Nobody has it" are our reading of each row. The answers and their sources are the evidence.</li>
      <li>Claims a tool makes only in its docs are labelled DOCS and were not checked in its code. GitHub stars change daily; they were read on the date in each column. Prices change often and are not listed here.</li>
      <li>The newest column was checked on {lastChecked}. The data behind this page is one file, <a href={dataUrl}>comparison.json</a>.</li>
      <li>Something wrong or out of date? <a href={issueUrl}>Open an issue</a> with a link to the tool's own code or docs, and we will check it and correct the page.</li>
    </ul>
  </section>

  <footer class="site">
    <p>Realm is an open-source workflow state machine for AI agents. Apache&#8209;2.0 &middot; <a href="https://github.com/sensigo-hq/realm">github.com/sensigo-hq/realm</a></p>
  </footer>

</div>
</body>
</html>
