---
import SiteNav from '../components/SiteNav.astro';
import '../styles/site.css';
import { THEME_INIT } from '../lib/theme-init.mjs';
import { ICON_LINKS, THEME_COLOR } from '../lib/favicon.mjs';
import PageMeta from '../components/PageMeta.astro';
import { HOW_IT_WORKS_DESCRIPTION } from '../lib/site-meta.mjs';
---

<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<script is:inline set:html={THEME_INIT}></script>
{ICON_LINKS.map((a) => <link {...a} />)}
<meta name="theme-color" content={THEME_COLOR} />
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
<PageMeta title="How a run moves — Realm" description={HOW_IT_WORKS_DESCRIPTION} path="/how-it-works/" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap" />
<style is:global>
/* charts + page parts (from the "How a run moves" artifact) */
.diagram{background:var(--panel);border:1px solid var(--line);border-radius:10px;padding:16px;overflow-x:auto}
.kinds{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:10px}
.kind{background:var(--panel);border:1px solid var(--line);border-radius:8px;padding:12px 14px;display:grid;gap:4px}
.kind b{font-family:"IBM Plex Mono",monospace;font-size:13px;color:var(--accent)}
.kind span{color:var(--muted);font-size:14px}
.fig{margin:0;display:grid;gap:12px}
.fig svg{width:100%;min-width:760px;height:auto;display:block;color:var(--ink);font-family:"IBM Plex Sans",system-ui,sans-serif}
.fig figcaption{color:var(--muted);font-size:14px;max-width:68ch}
.box{fill:var(--panel);stroke:var(--muted);stroke-width:1.2}
.engine{fill:var(--accent-soft);stroke:var(--accent);stroke-width:1.8}
.edge{stroke:currentColor;stroke-width:1.4;fill:none}
.dash{stroke-dasharray:5 4;stroke:var(--accent)}
.ahead{fill:currentColor}
.t{font-size:14px;font-weight:600;text-anchor:middle;fill:var(--ink)}
.t.big{font-size:20px;fill:var(--accent)}
.s{font-size:12px;text-anchor:middle;fill:var(--muted)}
.lbl{font-size:11.5px;text-anchor:middle;fill:var(--muted)}
.lbl.left{text-anchor:start;fill:var(--accent)}
.col{font-family:"IBM Plex Mono",monospace;font-size:10.5px;letter-spacing:.08em;text-anchor:middle;fill:var(--accent)}
.fig svg.narrow{display:none;min-width:0}
.t.sm{font-size:13px}
.lbl.mute{fill:var(--muted)}
@media (max-width:720px){
  .fig svg.wide{display:none}
  .fig svg.narrow{display:block}
}
.seqsvg{width:100%;height:auto;display:block;font-family:"IBM Plex Sans",system-ui,sans-serif}
.lifeline{stroke:var(--line);stroke-width:1.5;stroke-dasharray:3 4}
.ret{stroke-dasharray:5 4;stroke:var(--muted)}
.lbl.m{font-size:12.5px;fill:var(--ink)}
.band{fill:var(--accent-soft);opacity:.55;stroke:var(--line)}
.band.alt{fill:var(--warn-soft);opacity:.6}
.bandlbl{font-family:"IBM Plex Mono",monospace;font-size:11px;letter-spacing:.06em;text-transform:uppercase;fill:var(--accent)}
.divider{stroke:var(--line);stroke-dasharray:4 4}
.note{fill:var(--panel);stroke:var(--line)}
.seqsvg.narrow{display:none}
.ml{font-size:13.5px;text-anchor:middle;fill:var(--ink);paint-order:stroke;stroke:var(--panel);stroke-width:5px;stroke-linejoin:round}
.seqsvg.narrow .ml{font-size:12.5px}
.edge.sq{stroke-width:1.7}
.seqfig{padding:14px}
@media (max-width:720px){
  .seqsvg.wide{display:none}
  .seqsvg.narrow{display:block}
  .seqfig{padding:8px}
  .fig svg.narrow{min-width:0}
}
.lede code{white-space:nowrap}
</style>
</head>
<body>
<SiteNav />
<div class="wrap">

  <header class="hero">
    <div class="eyebrow">How it works</div>
    <h1>How a run moves</h1>
    <p class="lede">The engine owns the graph and the record. An LLM only answers <code>agent</code> steps. The same engine sits behind all three ways of driving a run: MCP, <code>realm agent</code>, and <code>realm listen</code>.</p>
  </header>

  <section>
    <div class="eyebrow">Overview</div>
    <h2>One engine, three front doors</h2>
    <figure class="diagram fig">
      <svg class="wide" viewBox="0 0 980 380" role="img" aria-label="Three drivers reach one engine: an MCP client through realm mcp, a webhook through realm listen which spawns realm agent, and realm agent which calls the model provider. The engine reads and writes the run store and hands gates to a human.">
        <defs>
          <marker id="ah" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0,0 L10,5 L0,10 z" class="ahead"/></marker>
        </defs>
        <!-- column labels -->
        <text x="105" y="18" class="col">WHO STARTS IT</text>
        <text x="355" y="18" class="col">REALM ENTRY POINT</text>
        <text x="640" y="18" class="col">CORE</text>
        <text x="895" y="18" class="col">STATE AND PEOPLE</text>

        <!-- row 1: MCP -->
        <rect x="20" y="30" width="170" height="60" rx="8" class="box"/>
        <text x="105" y="56" class="t">MCP client</text>
        <text x="105" y="74" class="s">Claude Code, any agent</text>
        <rect x="270" y="30" width="170" height="60" rx="8" class="box"/>
        <text x="355" y="56" class="t">realm mcp / serve</text>
        <text x="355" y="74" class="s">MCP server, stdio or HTTP</text>
        <line x1="190" y1="60" x2="268" y2="60" class="edge" marker-end="url(#ah)"/>
        <text x="229" y="52" class="lbl">tool calls</text>
        <line x1="440" y1="60" x2="538" y2="60" class="edge" marker-end="url(#ah)"/>
        <text x="489" y="52" class="lbl">execute_step</text>

        <!-- row 2: webhook -->
        <rect x="20" y="170" width="170" height="60" rx="8" class="box"/>
        <text x="105" y="196" class="t">External system</text>
        <text x="105" y="214" class="s">GitHub, Stripe, cron</text>
        <rect x="270" y="170" width="170" height="60" rx="8" class="box"/>
        <text x="355" y="196" class="t">realm listen</text>
        <text x="355" y="214" class="s">webhook server</text>
        <line x1="190" y1="200" x2="268" y2="200" class="edge" marker-end="url(#ah)"/>
        <text x="229" y="192" class="lbl">HTTP POST</text>
        <line x1="440" y1="200" x2="538" y2="200" class="edge" marker-end="url(#ah)"/>
        <text x="489" y="192" class="lbl">creates run</text>
        <line x1="355" y1="230" x2="355" y2="288" class="edge dash" marker-end="url(#ah)"/>
        <text x="363" y="263" class="lbl left">spawns, --run-id</text>

        <!-- row 3: realm agent -->
        <rect x="20" y="290" width="170" height="60" rx="8" class="box"/>
        <text x="105" y="316" class="t">Model provider</text>
        <text x="105" y="334" class="s">Anthropic or OpenAI</text>
        <rect x="270" y="290" width="170" height="60" rx="8" class="box"/>
        <text x="355" y="316" class="t">realm agent</text>
        <text x="355" y="334" class="s">the driver loop</text>
        <line x1="192" y1="320" x2="268" y2="320" class="edge" marker-start="url(#ah)" marker-end="url(#ah)"/>
        <text x="229" y="312" class="lbl">prompt / reply</text>
        <line x1="440" y1="320" x2="538" y2="320" class="edge" marker-end="url(#ah)"/>
        <text x="489" y="312" class="lbl">execute_step</text>

        <!-- engine -->
        <rect x="540" y="30" width="200" height="320" rx="10" class="engine"/>
        <text x="640" y="150" class="t big">Engine</text>
        <text x="640" y="172" class="s">execution-loop.ts</text>
        <text x="640" y="206" class="s">picks eligible steps (DAG)</text>
        <text x="640" y="226" class="s">validates outputs</text>
        <text x="640" y="246" class="s">runs auto + guard steps</text>
        <text x="640" y="266" class="s">writes the evidence</text>

        <!-- store -->
        <path d="M830,48 a65,12 0 0,0 130,0 a65,12 0 0,0 -130,0 v56 a65,12 0 0,0 130,0 v-56" class="box"/>
        <text x="895" y="86" class="t">Run store</text>
        <text x="895" y="104" class="s">~/.realm/runs</text>
        <line x1="742" y1="80" x2="828" y2="80" class="edge" marker-start="url(#ah)" marker-end="url(#ah)"/>
        <text x="785" y="72" class="lbl">read / write</text>

        <!-- human -->
        <rect x="830" y="270" width="130" height="80" rx="8" class="box"/>
        <text x="895" y="302" class="t">Human</text>
        <text x="895" y="320" class="s">respond, Slack,</text>
        <text x="895" y="336" class="s">or MCP</text>
        <line x1="740" y1="290" x2="828" y2="290" class="edge" marker-end="url(#ah)"/>
        <text x="785" y="282" class="lbl">gate opens</text>
        <line x1="828" y1="330" x2="742" y2="330" class="edge" marker-end="url(#ah)"/>
        <text x="785" y="322" class="lbl">answer</text>
      </svg>
      <svg class="narrow" viewBox="0 0 380 500" role="img" aria-label="Three lanes, one per driver, all flowing down into one engine, which reads and writes the run store and hands gates to a human.">
        <defs><marker id="ahm" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0,0 L10,5 L0,10 z" class="ahead"/></marker></defs>
        <text x="60" y="16" class="col">MCP</text>
        <text x="190" y="16" class="col">WEBHOOK</text>
        <text x="320" y="16" class="col">REALM AGENT</text>
        <rect x="10" y="26" width="100" height="50" rx="8" class="box"/><text x="60" y="56" class="t sm">MCP client</text>
        <rect x="140" y="26" width="100" height="50" rx="8" class="box"/><text x="190" y="56" class="t sm">External app</text>
        <rect x="270" y="26" width="100" height="50" rx="8" class="box"/><text x="320" y="56" class="t sm">Model API</text>
        <line x1="60" y1="76" x2="60" y2="124" class="edge" marker-end="url(#ahm)"/><text x="66" y="104" class="lbl left mute">tool calls</text>
        <line x1="190" y1="76" x2="190" y2="124" class="edge" marker-end="url(#ahm)"/><text x="196" y="104" class="lbl left mute">HTTP POST</text>
        <line x1="320" y1="78" x2="320" y2="124" class="edge" marker-start="url(#ahm)" marker-end="url(#ahm)"/><text x="326" y="98" class="lbl left mute">prompt</text><text x="326" y="112" class="lbl left mute">/ reply</text>
        <rect x="10" y="126" width="100" height="50" rx="8" class="box"/><text x="60" y="156" class="t sm">realm mcp</text>
        <rect x="140" y="126" width="100" height="50" rx="8" class="box"/><text x="190" y="156" class="t sm">realm listen</text>
        <rect x="270" y="126" width="100" height="50" rx="8" class="box"/><text x="320" y="156" class="t sm">realm agent</text>
        <line x1="240" y1="151" x2="268" y2="151" class="edge dash" marker-end="url(#ahm)"/><text x="255" y="192" class="lbl left" text-anchor="middle" style="text-anchor:middle">spawns</text>
        <line x1="60" y1="176" x2="60" y2="234" class="edge" marker-end="url(#ahm)"/><text x="66" y="210" class="lbl left mute">execute_step</text>
        <line x1="190" y1="176" x2="190" y2="234" class="edge" marker-end="url(#ahm)"/><text x="196" y="210" class="lbl left mute">creates run</text>
        <line x1="320" y1="176" x2="320" y2="234" class="edge" marker-end="url(#ahm)"/><text x="314" y="222" class="lbl mute" style="text-anchor:end">execute_step</text>
        <rect x="10" y="236" width="360" height="100" rx="10" class="engine"/>
        <text x="190" y="270" class="t big">Engine</text>
        <text x="190" y="294" class="s">picks eligible steps, validates outputs,</text>
        <text x="190" y="312" class="s">runs auto + guard steps, writes evidence</text>
        <line x1="90" y1="338" x2="90" y2="398" class="edge" marker-start="url(#ahm)" marker-end="url(#ahm)"/><text x="96" y="372" class="lbl left mute">read / write</text>
        <line x1="260" y1="336" x2="260" y2="398" class="edge" marker-end="url(#ahm)"/><text x="254" y="372" class="lbl mute" style="text-anchor:end">gate opens</text>
        <line x1="320" y1="398" x2="320" y2="338" class="edge" marker-end="url(#ahm)"/><text x="326" y="372" class="lbl left mute">answer</text>
        <path d="M10,412 a80,11 0 0,0 160,0 a80,11 0 0,0 -160,0 v56 a80,11 0 0,0 160,0 v-56" class="box"/>
        <text x="90" y="448" class="t sm">Run store</text><text x="90" y="466" class="s">~/.realm/runs</text>
        <rect x="200" y="400" width="170" height="78" rx="8" class="box"/>
        <text x="285" y="432" class="t sm">Human</text><text x="285" y="452" class="s">respond, Slack, MCP</text>
      </svg>
      <figcaption>Every path ends at the same engine call. The dashed arrow is the one hand-off between paths: <code>realm listen</code> starts a run, then a separate <code>realm agent</code> process drives it.</figcaption>
    </figure>
  </section>

  <section>
    <div class="eyebrow">Step kinds</div>
    <h2>The four step kinds</h2>
    <div class="kinds">
      <div class="kind"><b>auto</b><span>The engine runs a handler or service adapter. No LLM.</span></div>
      <div class="kind"><b>agent</b><span>The driver supplies the output: an LLM, or you over MCP.</span></div>
      <div class="kind"><b>guard</b><span>The engine checks a condition inline and continues or aborts.</span></div>
      
      <div class="kind"><b>finalizer</b><span>Cleanup the engine runs after the run ends.</span></div>
    </div>
    <p>A gate is not a fifth kind: a step can carry a gate, and the run then parks until a person answers.</p>
    <p>After every result, the engine validates and records it, then runs every <code>auto</code> and <code>guard</code> step it can reach. It stops at the next <code>agent</code> step, at a gate, or at the end. After a person answers a gate, the steps the engine owes are named in <code>next_actions</code> as one call, <code>advance_run</code> (or <code>realm run advance</code> from a shell). Step order comes from the definition (<code>depends_on</code>, <code>when</code>, <code>trigger_rule</code>), never from the LLM.</p>
  </section>

  <section>
    <div class="eyebrow">Path 1 · MCP</div>
    <h2>The external agent drives</h2>
    <p>Realm makes no model call. The client's own model does the agent steps and follows the instructions the engine returns in each reply.</p>
    <figure class="diagram fig seqfig"><svg class="seqsvg wide" viewBox="0 0 900 682" role="img" aria-label="An MCP client starts a run, then loops: its own model produces each agent step output, it calls execute_step, and the engine validates, records and replies with the next step."><defs><marker id="am1" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0,0 L10,5 L0,10 z" class="ahead"/></marker></defs><rect x="8" y="264" width="884" height="272" rx="8" class="band loop"/><rect x="8" y="550" width="884" height="112" rx="8" class="band alt"/><line x1="110.0" y1="76" x2="110.0" y2="676" class="lifeline"/><line x1="336.66666666666663" y1="76" x2="336.66666666666663" y2="676" class="lifeline"/><line x1="563.3333333333333" y1="76" x2="563.3333333333333" y2="676" class="lifeline"/><line x1="790.0" y1="76" x2="790.0" y2="676" class="lifeline"/><rect x="30.0" y="26" width="160" height="50" rx="8" class="box"/><text x="110.0" y="48" class="t">MCP client</text><text x="110.0" y="65" class="s">Claude Code, any agent</text><rect x="256.66666666666663" y="26" width="160" height="50" rx="8" class="box"/><text x="336.66666666666663" y="48" class="t">realm mcp</text><text x="336.66666666666663" y="65" class="s">MCP server</text><rect x="483.33333333333326" y="26" width="160" height="50" rx="8" class="engine"/><text x="563.3333333333333" y="48" class="t">Engine</text><text x="563.3333333333333" y="65" class="s">execution-loop.ts</text><rect x="710.0" y="26" width="160" height="50" rx="8" class="box"/><text x="790.0" y="48" class="t">Run store</text><text x="790.0" y="65" class="s">~/.realm/runs</text><line x1="112.0" y1="122" x2="333.66666666666663" y2="122" class="edge sq" marker-end="url(#am1)"/><text x="223.33333333333331" y="113" class="ml">get_workflow_protocol, then start_run</text><line x1="338.66666666666663" y1="162" x2="560.3333333333333" y2="162" class="edge sq" marker-end="url(#am1)"/><text x="449.999999999999