---
// The site menu of the home, how-it-works and comparison pages: the logo, the links (src/data/nav.js)
// and the light/dark switch. The docs pages show the same links through Starlight's header
// (src/components/DocsHeaderLinks.astro).
//
// On a screen narrower than 50rem, the width below which Starlight folds the docs header into its
// menu button, this menu folds the same way and opens the same menu as the docs: a full-page sheet
// under the header with the site links (src/components/MenuLinks.astro) at the top and the
// Light/Dark/Auto choice (src/components/SiteThemeSelect.astro) at the bottom. Like Starlight's, it is
// a popover: the browser opens and closes it, with or without scripts, and closes it on Escape or a
// tap outside it. A browser that has no popovers never shows the button, and the links stay on show
// under the logo (src/styles/site.css).
import { Icon } from '@astrojs/starlight/components';
import { ariaCurrent, nav } from '../data/nav.js';
import Logo from './Logo.astro';
import MenuLinks from './MenuLinks.astro';
import SiteThemeSelect from './SiteThemeSelect.astro';
import ThemeToggle from './ThemeToggle.astro';

const here = Astro.url.pathname;
---

<nav class="site" aria-label="Site" data-site-nav>
  <a class="brand" href="/" aria-label="Realm"><Logo /></a>
  <div class="nav-panel">
    <div class="links">
      {nav.map((l) => <a href={l.href} aria-current={ariaCurrent(l.href, here)}>{l.label}</a>)}
    </div>
    <ThemeToggle />
  </div>
  <button class="menu-btn" type="button" popovertarget="site-menu" aria-label="Menu">
    <Icon name="bars" class="open-icon" />
    <Icon name="close" class="close-icon" />
  </button>
  <div class="menu-sheet" id="site-menu" popover>
    <MenuLinks />
    <div class="menu-sheet-footer">
      <SiteThemeSelect />
    </div>
  </div>
</nav>
<script is:inline>
  (function () {
    var nav = document.querySelector('[data-site-nav]');
    if (!nav) return;
    var btn = nav.querySelector('.menu-btn');
    var sheet = nav.querySelector('#site-menu');
    var row = nav.querySelector('.nav-panel');
    if (!sheet || typeof sheet.showPopover !== 'function') return;
    var wide = window.matchMedia('(min-width: 50rem)');
    var benched = [];
    // The sheet starts under the header wherever the page is scrolled to.
    sheet.addEventListener('beforetoggle', function (e) {
      if (e.newState === 'open') {
        sheet.style.setProperty('--menu-top', Math.max(0, nav.getBoundingClientRect().bottom) + 'px');
      }
    });
    // While the sheet is open, the page under it is out of reach: Tab moves only between the header and
    // the sheet, as in the docs menu.
    sheet.addEventListener('toggle', function (e) {
      benched.forEach(function (el) {
        el.inert = false;
      });
      benched = [];
      if (e.newState !== 'open') return;
      for (var el = nav; el && el !== document.body; el = el.parentElement) {
        for (var sib = el.parentElement.firstElementChild; sib; sib = sib.nextElementSibling) {
          if (sib === el || sib.inert || /^(SCRIPT|STYLE|TEMPLATE)$/.test(sib.tagName)) continue;
          sib.inert = true;
          benched.push(sib);
        }
      }
    });
    function close() {
      if (sheet.matches(':popover-open')) sheet.hidePopover();
    }
    // Leaving the page closes the menu, so coming Back to it shows the menu closed.
    window.addEventListener('pagehide', close);
    // Crossing 50rem hides either the button and the sheet (wider) or the row of links (narrower), and
    // focus moves to what is now on show in its place: from the button or the sheet to the first link,
    // from a link or the switch to the button.
    function inSheet(el) {
      return el === btn || sheet.contains(el);
    }
    function refocus(lost) {
      if (wide.matches) {
        if (inSheet(lost)) row.querySelector('a').focus();
      } else if (row.contains(lost)) {
        btn.focus();
      }
    }
    wide.addEventListener('change', function () {
      var had = nav.contains(document.activeElement) ? document.activeElement : null;
      close();
      if (had && had.offsetParent === null) refocus(had);
    });
    // The browser sometimes drops focus from the hidden element before the change above runs. Losing
    // focus to nothing (no relatedTarget) is what hiding causes; a Tab or a click on another control
    // names where focus went and is left alone, and so is a click on plain page text, which leaves the
    // element on show.
    nav.addEventListener('focusout', function (e) {
      if (e.relatedTarget) return;
      var lost = e.target;
      setTimeout(function () {
        if (document.activeElement === document.body && lost.offsetParent === null) refocus(lost);
      });
    });
  })();
</script>
