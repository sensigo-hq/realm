---
// The site links (src/data/nav.js) as the first rows of the menu on a narrow screen. Both menus show
// them: the docs pages' (src/components/DocsSidebar.astro, above the docs contents) and the one of the
// home, how-it-works and comparison pages (src/components/SiteNav.astro). The colours are the shared
// palette's (src/styles/palette.css), which both kinds of page load.
import { ariaCurrent, nav } from '../data/nav.js';

const here = Astro.url.pathname;
---

<ul class="menu-links">
  {
    nav.map((l) => (
      <li>
        <a href={l.href} aria-current={ariaCurrent(l.href, here)}>
          {l.label}
        </a>
      </li>
    ))
  }
</ul>

<style>
  /* The site pages give every list a grid gap and a reading width (src/styles/site.css); the rows here
     sit edge to edge across the whole menu, as in the docs. */
  .menu-links {
    display: block;
    max-width: none;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 1rem;
    line-height: 1.5;
  }
  .menu-links li {
    margin: 0;
  }
  .menu-links li + li {
    border-top: 1px solid var(--c-line-soft);
  }
  .menu-links a {
    display: block;
    padding: 0.6875rem 0;
    color: var(--c-ink);
    font-weight: 500;
    text-decoration: none;
  }
  .menu-links a:hover,
  .menu-links a[aria-current] {
    color: var(--c-accent);
  }
  .menu-links a:focus-visible {
    outline: 2px solid var(--c-accent);
    outline-offset: 2px;
  }
</style>
