---
// The site links (src/data/nav.js) as rows in the menu on a narrow screen, in the block both menus
// end with (src/components/MenuBottom.astro). The colours are the shared palette's
// (src/styles/palette.css), which both kinds of page load.
import { ariaCurrent, nav } from '../data/nav.js';

const here = Astro.url.pathname;
---

<ul class="menu-links">
  {
    nav.map((l) => (
      <li>
        <a href={l.href} aria-current={ariaCurrent(l.href, here)}>
          {l.label}
        </a>
      </li>
    ))
  }
</ul>

<style>
  /* The rows the docs menu has shown since the site links moved into it: the body text, 0.6rem above
     and below, a soft line between rows, the current part of the site in the accent colour. The site
     pages give every list a grid gap and a reading width (src/styles/site.css); these rows sit edge
     to edge across the whole menu, as in the docs. */
  .menu-links {
    display: block;
    max-width: none;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 1rem;
  }
  .menu-links li {
    margin: 0;
  }
  .menu-links li + li {
    border-top: 1px solid var(--c-line-soft);
  }
  .menu-links a {
    display: block;
    padding: 0.6rem 0;
    color: var(--c-body);
    text-decoration: none;
  }
  .menu-links a:hover,
  .menu-links a[aria-current] {
    color: var(--c-accent);
  }
  .menu-links a:focus-visible {
    outline: 2px solid var(--c-accent);
    outline-offset: 2px;
  }
</style>
