<style>
  .logo {
    display: block;
    width: auto;
    /* the lockup's proportions, so the space for it is reserved before the file is drawn */
    aspect-ratio: 208.417 / 47.68;
    overflow: visible;
  }
  .mark {
    fill: var(--c-accent);
  }
  .word {
    fill: var(--c-ink);
  }
</style>
