---
// The Realm logo: the verdigris R and the wordmark, as one inline SVG. This is the brand kit's
// lockup (brand-kit/logo/realm-lockup-on-dark.svg and -on-light.svg),
// drawn once.
//
// The R takes the accent colour and the wordmark the ink colour, so the logo follows the site's own
// light/dark switch (src/styles/palette.css). In each theme that gives exactly the kit's lockup:
//   dark  : R #5EE6C1 (--c-accent), wordmark #F4F8FC (--c-ink)  = realm-lockup-on-dark
//   light : R #0B7A5F (--c-accent), wordmark #07121E (--c-ink)  = realm-lockup-on-light
//
// The kit's rules: the R is exactly as tall as the ascenders and sits on the baseline, so mark and
// word are one drawing and the R is never scaled or moved separately from the word. Clear space is half
// the height of the R on every side. Lockup minimum 80px wide on screen. The default height below
// gives about 131px.
interface Props {
  /** CSS height of the logo. The width follows from the lockup's proportions. */
  height?: string;
}
const { height = '30px' } = Astro.props;
---

<svg
  class="logo"
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 208.417 47.68"
  style={`height:${height}`}
  aria-hidden="true"
  focusable="false"
>
