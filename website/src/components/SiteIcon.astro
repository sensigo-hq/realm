interface Props {
  name: keyof typeof paths;
  class?: string;
}
const { name } = Astro.props;
---

<svg
  class:list={['site-icon', Astro.props.class]}
  width="16"
  height="16"
  viewBox="0 0 24 24"
  fill="currentColor"
  aria-hidden="true"
  focusable="false"><path d={paths[name]}></path></svg
>

<style>
  .site-icon {
    width: 1em;
    height: 1em;
  }
</style>
