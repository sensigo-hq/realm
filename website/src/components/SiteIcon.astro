interface Props {
  name: keyof typeof paths;
  class?: string;
}
const { name } = Astro.props;
// A name with no drawing here (say a new `icon` in src/data/nav.js) would draw nothing inside a link
// that can still be tabbed to; the build stops instead, naming the icon to add.
if (!(name in paths)) {
  throw new Error(`SiteIcon: no drawing for "${name}". Copy it from Starlight's Icons set into src/components/SiteIcon.astro.`);
}
---

<svg
  class:list={['site-icon', Astro.props.class]}
  width="16"
  height="16"
  viewBox="0 0 24 24"
  fill="currentColor"
  aria-hidden="true"
  focusable="false"><path d={paths[name]}></path></svg
>

<style>
  .site-icon {
    width: 1em;
    height: 1em;
  }
</style>
