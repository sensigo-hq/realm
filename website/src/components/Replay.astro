---
// Interactive replay of two recorded runs (scripts/replay/record.mjs -> distill.mjs -> replay.json).
// Every engine response shown is copied from the recording; only labels and blurbs are ours.
// Live mode (#624): "Try it yourself" loads the real engine into the page (src/live/, built by
// scripts/live/build.mjs) and every live answer comes from it; the live path never reads replay.json.
// Every visitor sentence, in both modes, comes from stageSentences() in src/live/view.mjs (the claim
// ledger sits above it); recorded mode calls it here, at build time.
import r from '../data/replay.json';
import manifest from '../live/manifest.json';
import { stageSentences, recordedState, recordedRun, evidenceRows, swappedLines } from '../live/view.mjs';
const short = (v: unknown): unknown =>
  typeof v === 'string' ? (v.length > 64 ? v.slice(0, 61) + '…' : v)
  : Array.isArray(v) ? v.map(short)
  : v && typeof v === 'object' ? Object.fromEntries(Object.entries(v).map(([k, x]) => [k, short(x)]))
  : v;
const j = (v: unknown) => JSON.stringify(short(v), null, 2);
const props = Object.entries(r.task.schema.properties as Record<string, any>).map(([name, p]) => ({
  name,
  type: p.enum ? p.enum.map((e: string) => `"${e}"`).join(' | ') : p.type === 'array' ? 'string[]' : p.type,
}));
const stages = ['Start', 'Agent step', 'Human gate', 'Write', 'Evidence'];
const endings = Object.values(r.endings);
const why = (x: any): string => x.error_details?.errors?.[0]?.message ?? x.context_hint;
const h8 = (h: string) => h.slice(0, 12);
// Backtick spans in a sentence are code.
const ticks = (s: string) => s.split('`');
// Step names wrap after an underscore, never inside a word.
const parts = (s: string) => s.split('_');
// Recorded mode's sentences, from the state after the answer derived from each ending.
const SR = (e: any) => stageSentences('recorded', recordedState(r, e));
const S = SR(endings[0]);
const swapped = swappedLines(manifest);
// Live-mode inputs, read at build: the bundle's URL, the start call, the five presets (inputs only)
// and the texts the page needs before the bundle has loaded.
const liveBundle = '/live/' + manifest.file;
const liveStart = JSON.stringify({ workflow_id: r.start.call.workflow_id, params: r.start.call.params });
const livePresets = JSON.stringify(Object.fromEntries(r.attempts.map((a) => [a.id, { command: a.call.command, params: a.call.params }])));
const liveNotes = JSON.stringify(S.notes);
---
<div class="rp" data-stage="0" data-ending="" data-mode="recorded" data-live-gate="closed" data-live-bundle={liveBundle} data-live-start={liveStart} data-live-presets={livePresets} data-live-notes={liveNotes} data-live-loading={S.loading}>
  <div class="rp-live-mark" data-live>
    <p data-say="marker"></p>
    <div class="rp-picks"><button type="button" data-act="new">{S.newRun}</button></div>
  </div>
  <ol class="rp-rail" role="tablist" aria-label="Run stages">
    {stages.map((s, i) => (
      <li><button type="button" role="tab" data-go={i} aria-selected={i === 0 ? 'true' : 'false'}><span>{String(i + 1).padStart(2, '0')}</span>{s}</button></li>
    ))}
  </ol>

  <div class="rp-stage" data-s="0">
    <h3 tabindex="-1">{S.start}</h3>
    <p>The first step is marked <code>auto</code>, so the engine runs it and no model is involved. The agent only learns what comes next.</p>
    <div class="rp-cols" data-rec>
      <div><p class="rp-k">Agent calls</p><pre>{j(r.start.call)}</pre></div>
      <div><p class="rp-k">Realm answers</p><pre>{j(r.start.response)}</pre></div>
    </div>
    <p class="rp-k" data-rec>What the step fetched — {r.start.pr.pr_title}, {r.start.pr.files_changed.length} files</p>
    <pre class="rp-diff" data-rec>{r.start.pr.diff_text.split('\n\n')[0]}</pre>
    <p class="rp-ev" data-rec>Evidence recorded for <code>fetch_pr</code> · hash <code title={r.start.evidence.hash}>{h8(r.start.evidence.hash)}…</code></p>
    <div class="rp-cols" data-live>
      <div><p class="rp-k">Agent calls</p><pre data-l="start-call"></pre></div>
      <div><p class="rp-k">Realm answers</p><pre data-l="start-reply"></pre><details><summary>Full reply</summary><pre data-l="start-full"></pre></details></div>
    </div>
    <p class="rp-k" data-live data-l="pr-head"></p>
    <pre class="rp-diff" data-live data-l="pr"></pre>
    <p class="rp-ev" data-live>Evidence recorded for <code>fetch_pr</code> · hash <code data-l="pr-hash"></code></p>
  </div>

  <div class="rp-stage" data-s="1" hidden>
    <h3 tabindex="-1">Realm hands the agent one task and one schema.</h3>
    <p data-rec>{r.task.human_readable.replace(/^Execute step '[^']+': /, '')} Pick what the agent sends back and see what Realm answered.</p>
    <p data-live>{r.task.human_readable.replace(/^Execute step '[^']+': /, '')} Pick or edit what the agent sends back, choose the step, and press Send.</p>
    <div data-rec>
      <div class="rp-picks"><button type="button" class="ok" data-live-try hidden>{S.tryLabel}</button></div>
      <p class="rp-hint" data-live-note hidden></p>
    </div>
    <div class="rp-cols">
      <div>
        <p class="rp-k">The schema for <code>{r.task.step}</code> — {S.schema}</p>
        <pre>{props.map((p) => `${p.name}: ${p.type}`).join('\n')}</pre>
        <div class="rp-picks" role="group" aria-label="What the agent submits">
          {r.attempts.map((a) => (
            <button type="button" data-pick={a.id} class={a.id === 'valid' ? 'ok' : ''}>{a.label}</button>
          ))}
        </div>
        <div class="rp-form" data-live>
          <label class="rp-k" for="rp-live-step">Step</label>
          <select id="rp-live-step" data-l="step"></select>
          <label class="rp-k" for="rp-live-box">Parameters (JSON)</label>
          <textarea id="rp-live-box" data-l="box" rows="12" spellcheck="false" autocapitalize="off" autocorrect="off"></textarea>
          <p class="rp-hint">The page sends at most 16 KB and 32 levels of nesting. These limits are the page's own, not Realm's.</p>
          <div class="rp-picks"><button type="button" class="ok" data-act="send">Send</button></div>
        </div>
      </div>
      <div class="rp-out" aria-live="polite" data-rec>
        <p class="rp-hint" data-out="none">{S.choose}</p>
        {r.attempts.map((a) => (
          <div data-out={a.id} hidden>
            <p>{a.blurb}</p>
            <p class="rp-k">Agent calls</p><pre>{j(a.call)}</pre>
            <p class={`rp-k ${a.id === 'valid' ? 'good' : 'bad'}`}>{a.id === 'valid' ? 'Realm accepts it' : 'Realm refuses'}</p>
            {a.id !== 'valid' && <p class="rp-why">{why(a.response)}</p>}
            <pre class={a.id === 'valid' ? 'good' : 'bad'}>{j(a.response)}</pre>
            {a.id === 'valid'
              ? <p class="rp-ev">{S.stop}</p>
              : <p class="rp-ev">{ticks(S.refusals).map((p, i) => (i % 2 ? <code>{p}</code> : p))}</p>}
          </div>
        ))}
      </div>
      <div class="rp-group" aria-live="polite" data-live>
        <p class="rp-hint" data-l="hint" hidden>{S.pressSend}</p>
        <div class="rp-out" data-box="send"></div>
        <p class="rp-ev" data-say="stop" hidden></p>
        <p class="rp-why" data-in="E" data-say="failed" hidden></p>
        <div class="rp-picks" data-in="E"><button type="button" data-act="new">{S.newRun}</button></div>
      </div>
    </div>
  </div>

  <div class="rp-stage" data-s="2" hidden>
    <h3 tabindex="-1" data-rec>{S.gate}</h3>
    <h3 tabindex="-1" data-live data-say="gate" hidden></h3>
    <p data-rec>{ticks(S.gateShown).map((p, i) => (i % 2 ? <code>{p}</code> : p))}</p>
    <p data-live data-say="gateShown" hidden></p>
    <p data-live data-say="beforeGate" hidden></p>
    <div class="rp-cols" data-rec>
      <div>
        <p class="rp-k">Gate message</p>
        <pre class="rp-msg">{r.gate.display}</pre>
      </div>
      <div>
        <p class="rp-k">You are the reviewer</p>
        <div class="rp-picks">
          {r.gate.choices.map((c) => <button type="button" class="ok" data-choose={c}>{c === 'approve' ? 'Approve' : 'Request changes'}</button>)}
        </div>
        <p class="rp-k">{S.skipLabel}</p>
        <div class="rp-picks">
          {r.gate.agent_attempts.map((a) => <button type="button" data-pick={a.id}>{a.label}</button>)}
        </div>
        <div class="rp-out" aria-live="polite">
          {r.gate.agent_attempts.map((a) => (
            <div data-out={a.id} hidden>
              <p class="rp-k">Agent calls</p><pre>{j(a.call)}</pre>
              <p class="rp-k bad">Realm refuses</p><p class="rp-why">{why(a.response)}</p><pre class="bad">{j(a.response)}</pre>
            </div>
          ))}
        </div>
      </div>
    </div>
    <div data-live>
      <div class="rp-cols" data-in="B C D">
        <div>
          <p class="rp-k">Gate message</p>
          <pre class="rp-msg" data-l="gate"></pre>
        </div>
        <div>
          <div class="rp-group" data-in="B">
            <p class="rp-k">You are the reviewer</p>
            <div class="rp-picks">
              {r.gate.choices.map((c) => <button type="button" class="ok" data-act="answer" data-choice={c}>{c === 'approve' ? 'Approve' : 'Request changes'}</button>)}
            </div>
            <p class="rp-k">{S.skipLabel}</p>
            <div class="rp-picks">
              {r.gate.agent_attempts.map((a) => <button type="button" data-act="skip" data-step={a.call.command}>{a.label}</button>)}
            </div>
            <div class="rp-out" aria-live="polite" data-box="skip"></div>
          </div>
          <p class="rp-why" data-in="C D" data-say="chose" hidden></p>
        </div>
      </div>
      <div class="rp-picks" data-in="E"><button type="button" data-act="new">{S.newRun}</button></div>
    </div>
  </div>

  <div class="rp-stage" data-s="3" hidden>
    <p class="rp-hint rp-need">{S.need4}</p>
    {endings.map((e) => (
      <div class="rp-end" data-end={e.choice} data-rec>
        <h3 tabindex="-1">{ticks(SR(e).branch).map((p, i) => (i % 2 ? <code>{p}</code> : p))}</h3>
        <p>{SR(e).agentSends}</p>
        <div class="rp-cols">
          <div>
            <p class="rp-k">The reviewer answers</p>
            <pre>{`$ ${e.respond.argv}\n${e.respond.stdout}`}</pre>
            {e.other_branch && (
              <>
                <p class="rp-k">{SR(e).otherTried}</p>
                <pre>{j(e.other_branch.call)}</pre>
                <p class="rp-k bad">Realm refuses</p>
                <p class="rp-why">{why(e.other_branch.response)}</p>
                <pre class="bad">{j(e.other_branch.response)}</pre>
              </>
            )}
          </div>
          <div>
            <p class="rp-k good">{ticks(SR(e).ran).map((p, i) => (i % 2 ? <code>{p}</code> : p))}</p>
            <pre class="good">{j(e.posted.response)}</pre>
            <p class="rp-k">{SR(e).skippedLabel}</p>
            <pre>{e.skipped}</pre>
          </div>
        </div>
      </div>
    ))}
    <div data-live>
      <div class="rp-end-live" data-in="C D">
        <h3 tabindex="-1" data-say="branch"></h3>
        <p data-say="agentSends" hidden></p>
        <div class="rp-cols">
          <div>
            <div class="rp-out" aria-live="polite" data-box="answer"></div>
            <div class="rp-picks" data-in="C"><button type="button" data-act="other">{S.otherLabel}</button></div>
            <div class="rp-out" aria-live="polite" data-box="other"></div>
          </div>
          <div>
            <div class="rp-picks" data-in="C"><button type="button" class="ok" data-act="post">{S.sendLabel}</button></div>
            <p class="rp-k good" data-say="ran" hidden></p>
            <div class="rp-out" aria-live="polite" data-box="post"></div>
            <div class="rp-group" data-l="sent2" hidden>
              <p data-say="sentFrom2" hidden></p>
              <div class="rp-table" role="table" data-l="sent2-row"></div>
            </div>
            <p class="rp-k" data-say="skippedLabel" hidden></p>
            <pre data-l="skip" hidden></pre>
          </div>
        </div>
      </div>
      <p class="rp-why" data-in="E" data-say="failedBeforeGate" hidden></p>
    </div>
  </div>

  <div class="rp-stage" data-s="4" hidden>
    <p class="rp-hint rp-need">{S.need5}</p>
    {endings.map((e) => (
      <div class="rp-end" data-end={e.choice} data-rec>
        <h3 tabindex="-1">{S.recordTitle}</h3>
        <p>{S.recordBody}</p>
        <p>Phase <code>{e.run_phase}</code> · sealed by <code>{e.sealed_by.arm}</code> at <code>{e.sealed_by.step}</code> · run <code>{e.run_id.slice(0, 8)}</code></p>
        <div class="rp-table" role="table">
          {evidenceRows(recordedRun(e)).map((x) => (
            <div role="row">
              <span role="cell"><code>{parts(x.step).map((p, i) => (i ? <>_<wbr />{p}</> : p))}</code></span>
              <span role="cell">{parts(x.label).map((p, i) => (i ? <>_<wbr />{p}</> : p))}</span>
              <span role="cell"><code title={x.hash}>{h8(x.hash)}…</code></span>
            </div>
          ))}
          <div role="row" class="skip">
            <span role="cell"><code>{parts(e.skipped_steps[0]).map((p, i) => (i ? <>_<wbr />{p}</> : p))}</code></span>
            <span role="cell">skipped</span>
            <span role="cell">no evidence</span>
          </div>
        </div>
        <p class="rp-ev">{ticks(S.readBack).map((p, i) => (i % 2 ? <code>{p}</code> : p))}</p>
      </div>
    ))}
    <div class="rp-end-live" data-live data-in="C D E">
      <h3 tabindex="-1" data-say="recordTitle" hidden></h3>
      <p data-say="recordBody" hidden></p>
      <div class="rp-table" role="table" data-l="table"></div>
      <p class="rp-ev" data-say="notFinished" hidden></p>
      <p class="rp-why" data-say="failed" hidden></p>
      <p class="rp-ev" data-say="readBack" hidden></p>
    </div>
  </div>

  <div class="rp-nav">
    <button type="button" data-prev disabled>Back</button>
    <span class="rp-pos" aria-live="polite">1 of {stages.length}</span>
    <button type="button" data-next class="ok">Next</button>
  </div>
  <p class="rp-foot" data-rec>{ticks(S.footer).map((p, i) => (i % 2 ? <code>{p}</code> : p))}</p>
  <div class="rp-foot-live" data-live>
    <p data-say="footer"></p>
    <details>
      <summary>{swapped.title}</summary>
      <p>{swapped.opening}</p>
      <ul>{swapped.lines.map((x) => <li>{x}</li>)}</ul>
    </details>
  </div>
</div>

<style is:global>
.rp{background:var(--panel);border:1px solid var(--line);border-radius:10px;padding:16px;display:grid;gap:14px;min-width:0}
.rp h3{font-size:17px}
.rp [tabindex="-1"]:focus{outline:none}
.rp p{font-size:14.5px;max-width:none}
.rp-rail{list-style:none;margin:0;padding:0;display:flex;flex-wrap:wrap;gap:6px;max-width:none}
.rp-rail button{font:500 13px/1 "IBM Plex Sans",sans-serif;padding:8px 11px;border-radius:5px;border:1px solid var(--line);
  background:transparent;color:var(--muted);cursor:pointer;display:flex;gap:7px;align-items:baseline}
.rp-rail button span{font:500 10.5px "IBM Plex Mono",monospace;color:var(--accent)}
.rp-rail button[aria-selected="true"]{background:var(--accent-soft);border-color:var(--accent);color:var(--ink)}
.rp-stage{display:grid;gap:10px;min-width:0}
.rp-stage[hidden],.rp [hidden]{display:none}
.rp-cols{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px;align-items:start}
.rp-cols > div{display:grid;gap:8px;min-width:0}
@media (max-width:760px){.rp-cols{grid-template-columns:minmax(0,1fr)}}
.rp-k{font:500 11.5px/1.4 "IBM Plex Mono",monospace!important;letter-spacing:.06em;text-transform:uppercase;color:var(--muted)}
.rp-k code{text-transform:none;letter-spacing:0}
.rp-k.bad{color:var(--warn)} .rp-k.good{color:var(--accent)}
.rp pre{margin:0;background:var(--panel2);border:1px solid var(--line-soft);border-radius:6px;padding:10px 12px;
  font:400 12.5px/1.55 "IBM Plex Mono",monospace;color:var(--ink);white-space:pre-wrap;overflow-wrap:anywhere}
.rp pre.rp-diff,.rp pre.rp-msg{max-height:420px;overflow:auto}
.rp-why{color:var(--ink);font-weight:600}
.rp pre.bad{border-color:var(--warn);background:var(--warn-soft)}
.rp pre.good{border-color:var(--accent);background:var(--accent-soft)}
.rp pre.rp-msg{font-family:"IBM Plex Sans",sans-serif;font-size:13.5px}
.rp-picks{display:flex;flex-wrap:wrap;gap:8px}
.rp-picks button,.rp-nav button{font:500 13.5px/1.2 "IBM Plex Sans",sans-serif;padding:9px 13px;border-radius:5px;cursor:pointer;
  border:1px solid var(--line);background:transparent;color:var(--ink)}
.rp-picks button[aria-pressed="true"]{border-color:var(--ink);box-shadow:inset 0 0 0 1px var(--ink)}
.rp button.ok{background:var(--c-accent);color:var(--c-on-accent);border-color:var(--c-accent)}
.rp-nav button:disabled,.rp [data-live-try]:disabled{opacity:.45;cursor:not-allowed}
.rp-out{display:grid;gap:8px;min-width:0}
.rp-out > div{display:grid;gap:8px;min-width:0}
.rp-hint{color:var(--muted)}
.rp-ev{color:var(--muted);font-size:13.5px!important}
.rp-end{display:none;gap:10px;min-width:0}
.rp[data-ending="approve"] .rp-end[data-end="approve"],.rp[data-ending="request_changes"] .rp-end[data-end="request_changes"]{display:grid}
.rp:not([data-ending=""]) .rp-need{display:none}
.rp-table{display:grid;border:1px solid var(--line-soft);border-radius:6px;overflow:hidden;font-size:13.5px}
.rp-table [role="row"]{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(0,1.3fr) minmax(0,.9fr);gap:10px;padding:8px 12px;border-top:1px solid var(--line-soft)}
.rp-table [role="row"]:first-child{border-top:0}
.rp-table [role="cell"]{overflow-wrap:anywhere}
.rp-table [role="cell"]:first-child,.rp-table [role="cell"]:nth-child(2){overflow-wrap:normal}
.rp-table .skip{color:var(--muted)}
.rp-nav{display:flex;justify-content:space-between;align-items:center;gap:12px;padding-top:4px;border-top:1px solid var(--line-soft);padding-top:12px}
.rp-pos{font:500 12px "IBM Plex Mono",monospace;color:var(--muted)}
.rp-foot{font-size:12.5px!important;color:var(--muted)}
/* Live mode (#624): two modes on one element; `!important` because .rp[data-ending] .rp-end (0,4,0)
   beats .rp [hidden] (0,2,0). Live blocks show only in the Live state table's states they name. */
.rp[data-mode="live"] [data-rec]{display:none!important}
.rp:not([data-mode="live"]) [data-live]{display:none!important}
.rp[data-live-state="A"] [data-in]:not([data-in~="A"]),.rp[data-live-state="B"] [data-in]:not([data-in~="B"]),
.rp[data-live-state="C"] [data-in]:not([data-in~="C"]),.rp[data-live-state="D"] [data-in]:not([data-in~="D"]),
.rp[data-live-state="E"] [data-in]:not([data-in~="E"]){display:none!important}
.rp[data-mode="live"]:not([data-live-state="A"]):not([data-live-state="B"]) .rp-need{display:none!important}
.rp-live-mark{display:flex;flex-wrap:wrap;gap:8px 14px;align-items:center;justify-content:space-between}
.rp .rp-live-mark p{font:500 12px/1.4 "IBM Plex Mono",monospace;color:var(--accent)}
.rp-end-live{display:grid;gap:10px;min-width:0}
.rp-group{display:grid;gap:8px;min-width:0}
.rp-form{display:grid;gap:8px;min-width:0}
.rp-form select,.rp-form textarea{font:400 12.5px/1.55 "IBM Plex Mono",monospace;color:var(--ink);background:var(--panel2);
  border:1px solid var(--line-soft);border-radius:6px;padding:8px 10px;width:100%;min-width:0;box-sizing:border-box}
.rp-form textarea{resize:vertical}
.rp details summary{cursor:pointer;font:500 12px "IBM Plex Mono",monospace;color:var(--muted)}
.rp details > pre{margin-top:6px}
.rp-foot-live,.rp .rp-foot-live p,.rp-foot-live li,.rp-foot-live summary{font-size:12.5px!important;color:var(--muted)}
.rp-foot-live{display:grid;gap:6px}
.rp-foot-live ul{margin:6px 0 0;padding-left:18px;display:grid;gap:3px}
</style>

<script is:inline>
(function () {
  var root = document.querySelector('.rp'); if (!root) return;
  var stages = root.querySelectorAll('.rp-stage'), tabs = root.querySelectorAll('[data-go]');
  var prev = root.querySelector('[data-prev]'), next = root.querySelector('[data-next]'), pos = root.querySelector('.rp-pos');
  var cur = 0, GATE = 2;
  function show(n, focus) {
    var was = document.activeElement;
    cur = Math.max(0, Math.min(stages.length - 1, n));
    stages.forEach(function (s, i) { s.hidden = i !== cur; });
    tabs.forEach(function (t, i) { t.setAttribute('aria-selected', i === cur ? 'true' : 'false'); });
    root.setAttribute('data-stage', cur);
    prev.disabled = cur === 0;
    var live = root.getAttribute('data-mode') === 'live';
    // Live: the live layer writes the waiting label (stageSentences' waitLabel) to data-live-wait,
    // empty when nothing waits at the gate.
    var lw = root.getAttribute('data-live-wait');
    var waiting = cur === GATE && (live ? !!lw : !root.getAttribute('data-ending'));
    next.disabled = cur === stages.length - 1 || waiting;
    next.textContent = waiting ? (live ? lw : 'Waiting for a human') : 'Next';
    pos.textContent = (cur + 1) + ' of ' + stages.length;
    // When the action hid or disabled the focused control, focus the new stage's heading.
    if (focus || ((was === next || was === prev) && was.disabled)) {
      var h = [].find.call(stages[cur].querySelectorAll('h3,.rp-need'), function (x) { return x.getClientRects().length; });
      if (h) { h.setAttribute('tabindex', '-1'); h.focus(); }
    }
  }
  tabs.forEach(function (t) { t.addEventListener('click', function () { show(+t.getAttribute('data-go')); }); });
  prev.addEventListener('click', function () { show(cur - 1); });
  next.addEventListener('click', function () { show(cur + 1); });
  root.querySelectorAll('[data-pick]').forEach(function (b) {
    b.addEventListener('click', function () {
      var stage = b.closest('.rp-stage');
      stage.querySelectorAll('[data-out]').forEach(function (o) { o.hidden = o.getAttribute('data-out') !== b.getAttribute('data-pick'); });
      stage.querySelectorAll('[data-pick]').forEach(function (x) { x.setAttribute('aria-pressed', x === b ? 'true' : 'false'); });
    });
  });
  root.querySelectorAll('[data-choose]').forEach(function (b) {
    b.addEventListener('click', function () {
      if (root.getAttribute('data-mode') === 'live') return; // live mode never writes data-ending
      root.setAttribute('data-ending', b.getAttribute('data-choose')); show(GATE + 1, true);
    });
  });
  // The live layer (the processed script below) moves the stepper through this event.
  root.addEventListener('rp-show', function (e) { show(e.detail.n == null ? cur : e.detail.n, e.detail.focus); });
  show(0);
})();
</script>

<script>
  // Live mode (#624): wires the DOM to the live bundle's exports (view.mjs's decisions, start()).
  // Text only: every engine or visitor string reaches the page through textContent or text nodes.
  const root = document.querySelector<HTMLElement>('.rp');
  if (root) {
    const D = root.dataset;
    const N = JSON.parse(D.liveNotes!), START = JSON.parse(D.liveStart!), PRE = JSON.parse(D.livePresets!);
    const q = (s: string) => root.querySelector<any>(s);
    const qa = (s: string) => root.querySelectorAll<any>(s);
    const el = (t: string, x?: string | null, c?: string) => {
      const e = document.createElement(t);
      if (x != null) e.textContent = x;
      if (c) e.className = c;
      return e;
    };
    const tryB = q('[data-live-try]'), note = q('[data-live-note]'), ed = q('[data-l=box]'), sel = q('[data-l=step]'), hint = q('[data-l=hint]');
    const box = (k: string) => q(`[data-box=${k}]`);
    let SS: any, M: any, E: any, rid: string, st: any, open: any, thr: any, T: any, gen = 0, busy = false, live = false, dead = false;
    // True once the stage-4 post box holds this run's accepted reply (a new run clears it).
    let postOk = false;
    const show = (n?: number, focus?: boolean) => root.dispatchEvent(new CustomEvent('rp-show', { detail: { n, focus } }));
    // The second click of a double-click (detail 2) is ignored, so a double-click sends one call even
    // when the first call has already returned.
    const one = (f: any) => (ev: any) => ev.detail > 1 || f(ev);
    const setBusy = (b: boolean) => {
      busy = b;
      qa('[data-act]').forEach((x: any) => (x.disabled = b));
    };
    // A fallback keeps the recording, with a note in the Try button's place and no live marker.
    const fall = (m: string) => {
      dead = true;
      live = false;
      gen++;
      clearTimeout(T);
      D.mode = 'recorded';
      delete D.liveState;
      D.liveGate = 'closed';
      delete D.liveWait;
      note.textContent = m;
      note.hidden = false;
      tryB.hidden = true;
      setBusy(false);
      show();
    };
    const say = (e: any, s: string | null) => {
      e.hidden = s == null;
      e.replaceChildren(...(s ?? '').split('`').map((p, i) => (i % 2 ? el('code', p) : p)));
    };
    const paint = (b: any, v: any) => {
      const l = el('p', v.label, 'rp-k ' + v.tone), n: any[] = [];
      if (v.who) n.push(el('p', v.who, 'rp-k'), el('pre', v.call));
      n.push(l);
      if (v.reason) n.push(el('p', v.reason, 'rp-why'));
      if (v.count) n.push(el('p', v.count, 'rp-ev'));
      if (v.shown) {
        const d = el('details');
        d.append(el('summary', 'Full reply'), el('pre', v.full));
        n.push(el('pre', v.shown, v.tone), d);
      }
      b.replaceChildren(...n);
      return l;
    };
    const code = (s: string) => {
      const c = el('code');
      s.split('_').forEach((p, i) => (i ? c.append('_', el('wbr'), p) : c.append(p)));
      return c;
    };
    const row = (s: string, l: string, h?: string) => {
      const r = el('div', null, h ? '' : 'skip'), c = el('code', h ? h.slice(0, 12) + '…' : null);
      r.setAttribute('role', 'row');
      if (h) c.title = h;
      const lab = el('span');
      l.split('_').forEach((p, i) => (i ? lab.append('_', el('wbr'), p) : lab.append(p)));
      for (const x of [code(s), lab, h ? c : 'no evidence']) {
        const k = el('span');
        k.setAttribute('role', 'cell');
        k.append(x);
        r.append(k);
      }
      return r;
    };
    const state = async () => (await E.call('get_run_state', { run_id: rid })).value;
    // Every live stage is a function of the run's state after the last reply.
    const render = async () => {
      const run = await E.run(rid);
      const vs = { ...st, choice: M.answeredChoice(run), threshold: thr, version: M.version, run_id: rid };
      const S = (SS = M.stageSentences('live', vs)), L = M.stateLetter(vs);
      D.liveState = L;
      D.liveGate = L == 'B' ? 'open' : L == 'C' || L == 'D' ? 'answered' : 'closed';
      if (S.waitLabel) D.liveWait = S.waitLabel;
      else delete D.liveWait;
      qa('[data-say]').forEach((e: any) => say(e, S[e.dataset.say]));
      const sk = q('[data-l=skip]');
      sk.textContent = S.skipped ?? '';
      sk.hidden = S.skipped == null;
      // D: "Ran:" shows the stage-4 post box when it holds this run's accepted reply; otherwise the
      // step was sent from stage 2, so that sentence and the step's row from the record show instead.
      const from2 = L == 'D' && !postOk;
      box('post').hidden = from2;
      q('[data-l=sent2]').hidden = !from2;
      const sent = from2 ? M.evidenceRows(run).find((x: any) => x.step == M.chosenStep(vs)) : null;
      q('[data-l=sent2-row]').replaceChildren(...(sent ? [row(sent.step, sent.label, sent.hash)] : []));
      q('[data-l=gate]').textContent = M.gateText(open) ?? '';
      q('[data-l=table]').replaceChildren(
        ...M.evidenceRows(run).map((x: any) => row(x.step, x.label, x.hash)),
        ...(st.skipped_steps ?? []).map((s: string) => row(s, 'skipped')),
      );
      show();
    };
    // One call at a time; a reply from a run that was replaced meanwhile is dropped.
    const act = async (tool: string, args: any, b: any, noCall = false, who?: string) => {
      if (busy || !live) return;
      const g = gen, before = st;
      setBusy(true);
      const r = await E.call(tool, { run_id: rid, ...args });
      if (g != gen) return;
      st = await state();
      if (r.kind == 'json') {
        if (r.value.gate?.display) open = r;
        thr = r.value.error_details?.threshold ?? thr;
      }
      const v = M.replyView({ tool, ...args }, r, before, st);
      if (noCall) v.who = null;
      else if (who) v.who = who;
      if (b == box('post')) postOk = v.tone == 'good';
      const l = paint(b, v);
      await render();
      setBusy(false);
      return l;
    };
    const newRun = async () => {
      const g = ++gen;
      setBusy(true);
      let e: any, s: any;
      try {
        e = await M.start();
        s = await e.call('start_run', START);
      } catch {
        return g == gen && fall(N.failedStart);
      }
      if (g != gen) return e.close();
      const v = s.kind == 'json' && s.value;
      if (!(v && v.status == 'ok' && typeof v.run_id == 'string'))
        return fall(N.noStart.replace('{code}', v ? v.error_code ?? v.status : 'no JSON reply'));
      clearTimeout(T);
      E?.close();
      E = e;
      rid = v.run_id;
      open = thr = null;
      postOk = false;
      qa('[data-box]').forEach((x: any) => x.replaceChildren());
      hint.hidden = true;
      st = await state();
      const sv = M.replyView({ tool: 'start_run', ...START }, s, null, st), f = M.fetched(s);
      q('[data-l=start-call]').textContent = sv.call;
      q('[data-l=start-reply]').textContent = sv.shown;
      q('[data-l=start-full]').textContent = sv.full;
      q('[data-l=pr-head]').textContent = f?.label ?? '';
      q('[data-l=pr]').textContent = f?.diff ?? '';
      const h = (await E.run(rid)).evidence[0]?.evidence_hash ?? '', hc = q('[data-l=pr-hash]');
      hc.textContent = h.slice(0, 12) + '…';
      hc.title = h;
      if (!sel.length) sel.append(...E.steps.map((x: string) => el('option', x)));
      const na = st.next_actions?.[0]?.instruction;
      sel.value = na?.params?.command ?? E.steps[1];
      ed.value = JSON.stringify(na?.call_with?.params ?? {}, null, 2);
      live = true;
      D.mode = 'live';
      D.ending = '';
      await render();
      setBusy(false);
      return true;
    };
    if (!isSecureContext) {
      note.textContent = N.insecure;
      note.hidden = false;
    } else {
      tryB.hidden = false;
      tryB.onclick = async () => {
        tryB.disabled = true;
        tryB.textContent = D.liveLoading;
        tryB.setAttribute('aria-busy', 'true');
        T = setTimeout(() => fall(N.timeout), 20000);
        try {
          M ??= await import(/* @vite-ignore */ new URL(D.liveBundle!, location.href).href);
        } catch {
          return dead || fall(N.noLoad);
        }
        if (!dead && (await newRun())) show(1, true);
      };
    }
    q('[data-s="1"]')
      .querySelectorAll('[data-pick]')
      .forEach((b: any) =>
        b.addEventListener('click', () => {
          if (!live || busy) return;
          const p = PRE[b.dataset.pick];
          sel.value = p.command;
          ed.value = JSON.stringify(p.params, null, 2);
          box('send').replaceChildren();
          hint.hidden = false;
        }),
      );
    q('[data-act=send]').onclick = one(async () => {
      if (!live || busy) return;
      const p = M.parseInput(ed.value), b = box('send');
      hint.hidden = true;
      const l = p.ok
        ? await act('execute_step', { command: sel.value, params: p.value }, b)
        : paint(b, M.replyView(null, { kind: 'page', message: p.message }, st, st));
      if (p.note) b.append(el('p', p.note, 'rp-ev'));
      if (l) b.scrollIntoView({ block: 'nearest' });
    });
    qa('[data-act=answer]').forEach(
      (b: any) =>
        (b.onclick = one(async () => {
          const l = await act('submit_human_response', { gate_id: st.pending_gate?.gate_id, choice: b.dataset.choice }, box('answer'));
          if (l && D.liveGate == 'answered') show(3, true);
        })),
    );
    qa('[data-act=skip]').forEach((b: any) => (b.onclick = one(() => act('execute_step', { command: b.dataset.step, params: {} }, box('skip')))));
    // "Ran:" shows the reply without the call, as the recording does; focus goes to stage 4's heading
    // because the button that had it is gone once the step is sent.
    q('[data-act=post]').onclick = one(async () => {
      const l = await act('execute_step', { command: M.nextActions(st).send, params: {} }, box('post'), true);
      if (l) show(3, true);
    });
    q('[data-act=other]').onclick = one(() =>
      act('execute_step', { command: M.nextActions(st).other, params: {} }, box('other'), false, SS.otherTried),
    );
    qa('[data-act=new]').forEach(
      (b: any) =>
        (b.onclick = one(async () => {
          if (!busy && (await newRun())) show(1, true);
        })),
    );
  }
</script>
