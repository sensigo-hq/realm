{
  "name": "@sensigo/realm-mcp",
  "version": "0.49.1-dev.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "MCP server for Realm: lets an AI agent run Realm workflows.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/sensigo-hq/realm.git"
  },
  "homepage": "https://realmengine.dev",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai-agent",
    "agent-workflow",
    "workflow",
    "typescript"
  ],
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./home": {
      "import": "./dist/home-server.js",
      "types": "./dist/home-server.d.ts"
    },
    "./dist/tools/*.js": {
      "import": "./dist/tools/*.js",
      "types": "./dist/tools/*.d.ts"
    }
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "realm-mcp": "./dist/bin.js"
  },
  "scripts": {
    "build": "tsc --build",
    "test": "vitest run",
    "lint": "eslint src"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.0",
    "@sensigo/realm": "*",
    "@sensigo/realm-store-sqlite": "*",
    "proper-lockfile": "^4.1.2",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@pydantic/genai-prices": ">=0.1.12"
  },
  "peerDependenciesMeta": {
    "@pydantic/genai-prices": {
      "optional": true
    }
  },
  "devDependencies": {
    "@pydantic/genai-prices": "0.2.1",
    "@sensigo/realm-testing": "*",
    "@types/node": "^26.1.1",
    "@types/proper-lockfile": "^4.1.4",
    "typescript": "*",
    "vitest": "^4.1.0"
  },
  "files": [
    "dist",
    "!dist/tsconfig.tsbuildinfo",
    "!dist/**/test-support/**",
    "README.md"
  ]
}
