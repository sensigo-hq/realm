{
  "name": "@sensigo/realm-store-sqlite",
  "version": "0.49.1-dev.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "SQLite-backed stores for Realm: runs, duplicate-webhook ids, workflow definitions, failed attempts, replays and trace buffers, in one realm.db file in the Realm home.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/sensigo-hq/realm.git"
  },
  "homepage": "https://realmengine.dev",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./test-support": {
      "import": "./dist/test-support/index.js",
      "types": "./dist/test-support/index.d.ts"
    }
  },
  "engines": {
    "node": "^22.22.3 || >=24.15.0"
  },
  "scripts": {
    "build": "tsc --build",
    "test": "vitest run",
    "lint": "eslint src"
  },
  "dependencies": {
    "@sensigo/realm": "*"
  },
  "devDependencies": {
    "@sensigo/realm-testing": "*",
    "@types/node": "^26.1.1",
    "typescript": "*",
    "vitest": "^4.1.0"
  },
  "files": [
    "dist",
    "!dist/tsconfig.tsbuildinfo",
    "!dist/**/test-support/**",
    "dist/test-support/index.*",
    "dist/test-support/foreign-connection.*",
    "dist/test-support/plant-registry-row.*",
    "README.md"
  ]
}
