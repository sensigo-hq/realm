        "WORK/08.realm.json"
      ],
      "exit": 0
    },
    {
      "argv": [
        "realm",
        "workflow",
        "register",
        "WORK/project/one-step.yaml"
      ],
      "exit": 0
    },
    {
      "argv": [
        "realm",
        "agent",
        "--workflow",
        "WORK/project/one-step.yaml",
        "--params",
        "{\"note\":\"The corpus recorder drives the published CLI.\"}",
