        "run",
        "respond",
        "RUN_08",
        "--gate",
        "GATE_08",
        "--choice",
        "approve"
      ],
      "exit": 0
    },
    {
      "argv": [
        "realm",
        "agent",
        "--workflow",
        "WORK/project/workflow.yaml",
        "--params",
        "{\"repo\":\"acme/payments-api\",\"pr_number\":42}",
        "--provider-module",
        "NM/corpus-provider-module.mjs"
      ],
      "exit": 0
    },
    {
      "argv": [
